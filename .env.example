PORT=5000
NODE_ENV=development
LOG_LEVEL=info
TZ=Africa/Addis_Ababa

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=legal_sys

# Auth
JWT_ACCESS_SECRET=dev-access-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-minimum-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_HTTP_ONLY=true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_PATH=/api/auth
REFRESH_TOKEN_REUSE_DETECTION=true
# Bcrypt hash cost: 12 for production, 4 for fast tests
PASSWORD_HASH_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:9001

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
